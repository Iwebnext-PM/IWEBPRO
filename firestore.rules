rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ((request.auth.token.email == 'rituparno.tnts@gmail.com' || request.auth.token.email == 'text202@gmail.com') && request.auth.token.email_verified == true)
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global site settings (contact info, theme, SEO)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Homepage section content
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(sectionId);
    }

    // Pages management
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(pageId);
    }

    // Services management
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }

    // Service areas
    match /serviceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(areaId);
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(testimonialId);
    }

    // FAQs
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(faqId);
    }

    // Media library assets
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(mediaId);
    }

    // Navigation and menu configuration
    match /navigation/{navId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(navId);
    }

    // Customer lead form submissions
    match /contactSubmissions/{submissionId} {
      // Public visitors can submit quote/service inquiries with validated payload
      allow create: if isValidId(submissionId)
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.customerName.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 7
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.serviceRequired is string
                    && request.resource.data.serviceRequired.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 3000;
      
      // Only authorized administrators can view, update status, add notes, or delete leads
      allow read, update, delete: if isAdmin() && isValidId(submissionId);
    }

    // Activity audit logs
    match /activityLogs/{logId} {
      allow read, write: if isAdmin() && isValidId(logId);
    }
  }
}
